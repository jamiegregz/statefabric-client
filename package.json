{
  "name": "@statefabric/client",
  "version": "0.1.0",
  "description": "TypeScript client for the StateFabric session and compacted-context APIs.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamiegregz/statefabric-client.git"
  },
  "bugs": {
    "url": "https://github.com/jamiegregz/statefabric-client/issues"
  },
  "homepage": "https://github.com/jamiegregz/statefabric-client#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "format:check": "prettier --config ./prettier.json --check .",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "verify": "npm run lint && npm run format:check && npm run check && npm run test && npm run build",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
